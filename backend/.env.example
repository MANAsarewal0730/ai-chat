# AI Study Assistant - Environment Configuration
PORT=5000

# Default LLM Provider: "gemini" or "openai"
DEFAULT_PROVIDER=gemini

# Google Gemini API Key (Get free from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
